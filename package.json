{
  "name": "git-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "git-insight": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "test": "node test/run-tests.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc && npm run chmod:bin",
    "chmod:bin": "node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.6.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "slice-ansi": "^7.1.2",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
